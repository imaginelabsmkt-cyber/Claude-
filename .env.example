# =============================================================
# Variáveis de ambiente — Sistema de Gestão de Conteúdo
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA versione o arquivo .env.local (já está no .gitignore).
# =============================================================

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon) do Supabase — segura para uso no navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# URL base da aplicação (usada em callbacks de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
