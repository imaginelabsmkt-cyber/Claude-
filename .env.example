# =============================================================
# Variáveis de ambiente — Sistema de Gestão de Conteúdo
#
# Copie este arquivo para `.env.local` (desenvolvimento) e preencha os
# valores. NUNCA versione o `.env.local` (já está no .gitignore).
# Na Vercel, cadastre as MESMAS variáveis em Settings > Environment
# Variables. Não coloque chaves reais neste arquivo de exemplo.
# =============================================================

# --- OBRIGATÓRIAS ---
# URL do projeto Supabase (Dashboard > Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" do Supabase (Project Settings > API > Project API keys
# > anon public). É segura para uso no navegador. NÃO use a service_role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# --- OPCIONAL ---
# URL base da aplicação. Útil para futuras funcionalidades de auth por
# link (recuperação de senha/convite). Em produção, use o domínio da Vercel.
# NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app

# =============================================================
# COBRANÇA DE TRÁFEGO (WhatsApp + automação)
# =============================================================

# Chave service_role do Supabase (Project Settings > API). Usada SOMENTE
# no servidor pelas rotas de automação (cron), que rodam sem sessão de
# usuário. NUNCA exponha no navegador (não use prefixo NEXT_PUBLIC_).
# SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# Segredo das rotas de automação (/api/cron/*). Gere um valor aleatório
# forte. O Vercel Cron envia automaticamente como "Authorization: Bearer".
# CRON_SECRET=um_valor_aleatorio_bem_grande

# Provedor de WhatsApp: "simulacao" (padrão, não envia nada — modo teste),
# "evolution" (Evolution API, auto-hospedada e gratuita) ou "zapi" (Z-API).
# WHATSAPP_PROVIDER=simulacao

# --- Se WHATSAPP_PROVIDER=evolution ---
# EVOLUTION_API_URL=https://sua-evolution-api.com
# EVOLUTION_API_KEY=sua_api_key
# EVOLUTION_INSTANCE=nome_da_instancia

# --- Se WHATSAPP_PROVIDER=zapi ---
# ZAPI_INSTANCE=sua_instancia
# ZAPI_TOKEN=seu_token
# ZAPI_CLIENT_TOKEN=seu_client_token
